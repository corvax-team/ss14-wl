<paper:PaperWindow xmlns="https://spacestation14.io"
    xmlns:paper="clr-namespace:Content.Client.Paper.UI"
    xmlns:wlpaper="clr-namespace:Content.Client._WL.Paper.UI"
    MouseFilter="Stop" Resizable="True" MinSize="150 150"
    SetSize="510 660"> <!-- Provide some reasonable sizes by default. Can be changed by the component --> <!-- WL-Changes -->

    <BoxContainer Name="ContentsRoot" Orientation="Vertical">
        <PanelContainer StyleClasses="BackgroundPanel" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6">
            <TextureButton Name="CloseButton" StyleClasses="windowCloseButton"/>
        </PanelContainer>
        <BoxContainer Orientation="Horizontal" VerticalExpand="True" HorizontalExpand="True"> <!-- WL-Changes -->
            <!-- WL-Changes-Start -->
            <BoxContainer Name="DrawingTools" Orientation="Vertical" Visible="False"
                VerticalExpand="True" MinSize="400 0" Margin="6">
                <ColorSelectorSliders Name="DrawingColorSelector" IsAlphaVisible="True" />
                <Label Name="BrushRadiusLabel" VerticalAlignment="Center" />
                <Slider Name="BrushRadiusSlider" HorizontalExpand="True"
                    MinValue="1" MaxValue="25" Value="1" Rounded="True" />
                <Label Name="BrushRadiusValueLabel" VerticalAlignment="Center" />
                <BoxContainer Orientation="Horizontal">
                    <Button Name="CircleButton" ToggleMode="True" HorizontalExpand="True"/>
                    <Button Name="LineButton" ToggleMode="True" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="EraserButton" ToggleMode="True" HorizontalExpand="True" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal">
                    <Button Name="UndoButton" Visible="False" HorizontalExpand="True" />
                    <Button Name="RedoButton" Visible="False" HorizontalExpand="True" />
                </BoxContainer>
            </BoxContainer>
            <!-- WL-Changes-End -->
            <PanelContainer Name="PaperBackground" StyleIdentifier="PaperDefaultBorder" VerticalExpand="True" HorizontalExpand="True">
                <ScrollContainer Name="ScrollingContents" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
                    <PanelContainer Name="PaperContent" VerticalExpand="True" HorizontalExpand="True" MaxWidth="600">
                        <BoxContainer Orientation="Vertical" VerticalAlignment="Stretch">
                            <TextureButton Name="HeaderImage" HorizontalAlignment="Center" VerticalAlignment="Top" MouseFilter="Ignore"/>
                            <Control Name="TextAlignmentPadding" VerticalAlignment="Top"/>
                            <RichTextLabel Name="BlankPaperIndicator" StyleClasses="LabelWeak" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                            <RichTextLabel StyleClasses="PaperWrittenText" Name="WrittenTextLabel" VerticalAlignment="Top"/>
                            <BoxContainer Name="InputContainer" StyleIdentifier="PaperContainer" Orientation="Vertical" VerticalExpand="True" VerticalAlignment="Stretch">
                                <PanelContainer StyleIdentifier="PaperEditBackground" MinHeight="100"
                                    VerticalAlignment="Stretch" VerticalExpand="True" HorizontalExpand="True">
                                    <TextEdit Name="Input" StyleClasses="PaperLineEdit" Access="Public" />
                                </PanelContainer>
                                <Label Name="FillStatus" StyleClasses="LabelSecondaryColor"/>
                            </BoxContainer>
                            <TextureButton Name="FooterImage" HorizontalAlignment="Center" VerticalAlignment="Top" MouseFilter="Ignore"/>
                        </BoxContainer>
                        <wlpaper:PaperDrawingControl Name="DrawingCanvas" Access="Public"/> <!-- WL-Changes -->
                        <paper:StampCollection Name="StampDisplay" VerticalAlignment="Bottom" Margin="6"/>
                    </PanelContainer>
                </ScrollContainer>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Name="EditButtons" Orientation="Vertical" HorizontalExpand="True" Margin="6"> <!-- WL-Changes -->
            <!-- WL-Changes-Start -->
            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Name="DrawButton" />
                <Button Name="WriteButton" Visible="False" />
                <Button Name="SaveButton" />
            </BoxContainer>
            <!-- WL-Changes-End -->
        </BoxContainer>
    </BoxContainer>
</paper:PaperWindow>
