<Control xmlns="https://spacestation14.io"
         xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5">
        <PanelContainer HorizontalExpand="True" Margin="0 0 0 5">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#252525" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="8 6">
                <LineEdit Name="SearchEdit" HorizontalExpand="True"
                          PlaceHolder="{Loc 'humanoid-profile-editor-bark-placeholder'}"/>
                <Label Name="ResultsLabel" MinWidth="120" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Margin="10 0 0 0"/>
            </BoxContainer>
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">
            <PanelContainer HorizontalExpand="False" VerticalExpand="True"
                            MinWidth="205" MaxWidth="235" Margin="0 0 5 0">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1A1A1A" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5">
                    <Label Text="{Loc 'humanoid-profile-editor-bark-categories'}"
                           StyleClasses="LabelHeading" HorizontalAlignment="Center" Margin="0 2 0 7"/>
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                        <BoxContainer Name="CategoriesContainer" Orientation="Vertical" HorizontalExpand="True"/>
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>

            <PanelContainer HorizontalExpand="True" VerticalExpand="True" MinWidth="500">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1A1A1A" />
                </PanelContainer.PanelOverride>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" Margin="5">
                    <Label Name="SelectedCategoryLabel" StyleClasses="LabelHeading"
                           HorizontalAlignment="Center" Margin="0 2 0 7"/>
                    <ScrollContainer VerticalExpand="True" HorizontalExpand="True">
                        <GridContainer Name="BarksGrid" Columns="2" HorizontalExpand="True"/>
                    </ScrollContainer>
                </BoxContainer>
            </PanelContainer>
        </BoxContainer>

        <PanelContainer HorizontalExpand="True" Margin="0 5 0 0">
            <PanelContainer.PanelOverride>
                <graphics:StyleBoxFlat BackgroundColor="#252525" />
            </PanelContainer.PanelOverride>
            <BoxContainer Orientation="Vertical" Margin="10 7">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <Label Text="{Loc 'humanoid-profile-editor-bark-settings'}"
                           StyleClasses="LabelHeading" VerticalAlignment="Center"/>
                    <Label Name="SelectedBarkLabel" HorizontalExpand="True"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10 0"/>
                    <Button Name="PreviewButton" Text="{Loc 'humanoid-profile-editor-bark-play'}"
                            MinWidth="120"/>
                    <Button Name="ResetButton" Text="{Loc 'humanoid-profile-editor-bark-reset'}"
                            MinWidth="120" Margin="5 0 0 0"/>
                </BoxContainer>
                <LineEdit Name="PreviewTextEdit" HorizontalExpand="True" Margin="0 7 0 0"
                          PlaceHolder="{Loc 'humanoid-profile-editor-bark-preview-text-placeholder'}"/>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 7 0 0">
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Text="{Loc 'humanoid-profile-editor-bark-pitch-label'}"
                               VerticalAlignment="Center"/>
                        <LineEdit Name="PitchEdit" MinWidth="90" HorizontalExpand="True" Margin="7 0 12 0"/>
                    </BoxContainer>
                    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                        <Label Text="{Loc 'humanoid-profile-editor-bark-delay-short-label'}"
                               VerticalAlignment="Center"/>
                        <LineEdit Name="DelayVariationMinEdit" MinWidth="80" HorizontalExpand="True" Margin="7 0 3 0"/>
                        <Label Text="-" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="20"/>
                        <LineEdit Name="DelayVariationMaxEdit" MinWidth="80" HorizontalExpand="True" Margin="3 0 0 0"/>
                    </BoxContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</Control>
