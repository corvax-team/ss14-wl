<controls:FancyWindow
    xmlns="https://spacestation14.io"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:ui="clr-namespace:Content.Client.Materials.UI"
    Title="{Loc 'flatpacker-ui-title'}"
    MinSize="550 350">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" Margin="10">
        <BoxContainer SizeFlagsStretchRatio="2" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical">
                <EntityPrototypeView Name="ObjectSprite" Scale="4 4" HorizontalAlignment="Center" VerticalExpand="True" MinSize="128 128"/>
                <RichTextLabel Name="MachineNameLabel" HorizontalAlignment="Center" StyleClasses="LabelKeyText"/>
            </BoxContainer>
            <Control MinHeight="10"/>
            <BoxContainer Orientation="Horizontal">
                <Button Name="AnalyzeButton" Text="{Loc 'flatpacker-ui-pack-button'}" MaxWidth="150" Margin="0 0 0 10"/>
                <Button Name="DAnalyzeButton" Text="{Loc 'flatpacker-ui-pack-button'}" MaxWidth="150" Margin="0 0 0 10"/>
                <Button Name="DestructButton" Text="{Loc 'flatpacker-ui-pack-button'}" MaxWidth="150" Margin="0 0 0 10"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" VerticalExpand="True" RectClipContent="True">
                <Label Name="CostHeaderLabel" Text="{Loc 'flatpacker-ui-cost-label'}" HorizontalAlignment="Left"/>
                <PanelContainer VerticalExpand="True"
                                HorizontalExpand="True" StyleClasses="PanelDeep">
                    <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                        <RichTextLabel Name="StatusLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
        <Control MinWidth="10"/>
        <BoxContainer SizeFlagsStretchRatio="3" Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Label Text="{Loc 'flatpacker-ui-materials-label'}" HorizontalAlignment="Center" Margin="0 0 0 5"/>
            <PanelContainer
                VerticalExpand="True"
                HorizontalExpand="True"
                RectClipContent="True" StyleClasses="PanelDeep">
                <RichTextLabel Name="DataLabel" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
